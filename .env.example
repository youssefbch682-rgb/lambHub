# Copie ce fichier en .env à la racine avant de lancer docker-compose.
# Génère une valeur aléatoire longue : openssl rand -base64 48
JWT_SECRET=change-moi-en-valeur-aleatoire-longue

# Compte admin créé automatiquement au premier démarrage.
# Change ces valeurs avant de lancer "docker compose up" !
ADMIN_EMAIL=toi@lamberet.fr
ADMIN_PASSWORD=change-moi-aussi

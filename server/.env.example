# Ce fichier ne sert QUE pour lancer le backend en local sans Docker (npm start).
# Pour le déploiement docker-compose, les valeurs sont directement dans
# docker-compose.yml (variable "environment" du service backend) — inutile
# de créer un .env pour ça.
#
# Copie ce fichier en .env et remplis les valeurs (ne jamais committer le .env réel)

# Secret utilisé pour signer les tokens de session — génère une valeur aléatoire longue :
# openssl rand -base64 48
JWT_SECRET=change-moi

# Utilisés uniquement par `npm run seed:admin` pour créer le tout premier compte admin
ADMIN_EMAIL=toi@lamberet.fr
ADMIN_PASSWORD=change-moi-aussi
